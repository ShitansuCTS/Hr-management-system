generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

///////////////////////////
// ENUMS
///////////////////////////

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum HolidayType {
  NATIONAL
  FESTIVAL
  COMPANY
}

enum LeaveType {
  PAID_LEAVE
  SICK_LEAVE
  CASUAL_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementSendType {
  ALL
  INDIVIDUAL
}

enum AttendanceStatus {
  PRESENT
  INCOMPLETE
  ABSENT
}

enum CalendarEventCategory {
  MEETING
  TRAINING
  DEADLINE
  TASK
  REMINDER
  OTHER
}

///////////////////////////
// ORGANIZATION
///////////////////////////
model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String? // optional, e.g., company email domain
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[] // 1:N relation to Users
  departments    Department[]
  designations   Designation[]

  holidays       Holiday[]
  announcements  Announcement[]
  documents      UserDocument[]
  attendances    Attendance[]
  calendarEvents CalendarEvent[]

  leaveApplications LeaveApplication[]
  leaveBalances     LeaveBalance[]
  leaveComments     LeaveComment[]
}

///////////////////////////
// USER
///////////////////////////
model User {
  id String @id @default(uuid())

  // =========================
  // Login & Auth
  // =========================
  email       String @unique    
  password    String
  role        Role
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  // =========================
  // Employee Core Details
  // =========================
  employeeId    String // given by HR
  fullName      String
  phone         String
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])
  employmentType EmploymentType?
  workLocation   String?
  dateOfJoining  DateTime

  // =========================
  // Personal Details
  // =========================
  profileImageUrl      String?
  
  gender               Gender?
  dateOfBirth          DateTime?
  fatherName           String?
  motherName           String?
  bloodGroup           String?

  // =========================
  // Address Details
  // =========================
  currentAddress   String?
  permanentAddress String?
  city             String?
  state            String?
  country          String?
  pincode          String?

  // =========================
  // Emergency Contact
  // =========================
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // =========================
  // Reporting Manager (Simple)
  // =========================
  reportingManagerName String?

  // =========================
  // Organization Relation
  // =========================
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  // =========================
  // Leave Balance
  // =========================
  leaveBalances    LeaveBalance[]
  LeaveApplication LeaveApplication[]

  // =========================
  // Announcements
  // =========================
  createdAnnouncements Announcement[]          @relation("CreatedAnnouncements")
  announcementReceipts AnnouncementRecipient[]

  // =========================
  // Calender Events
  // =========================
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreatedBy")

  updatedCalendarEvents CalendarEvent[] @relation("CalendarEventUpdatedBy")

  deletedCalendarEvents CalendarEvent[] @relation("CalendarEventDeletedBy")

  // =========================
  // System & Safety
  // =========================
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // =========================
  // Finance and Payroll
  // =========================
  financialDetails FinancialDetails?
  payrollSettings  PayrollSettings?
  spouseName       String?

  // =========================
  // Documents
  // =========================
  documents         UserDocument[]
  uploadedDocuments UserDocument[] @relation("UploadedDocuments")

  // =========================
  // Attendance Status
  // =========================
  attendances Attendance[]

  // =========================
  // Reset and Forgot Token
  // =========================
  resetPasswordToken   String?
  resetPasswordExpires BigInt? // or DateTime

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leaveComments LeaveComment[]

  @@unique([organizationId, employeeId])
}

///////////////////////////
// HOLIDAY
///////////////////////////
model Holiday {
  id String @id @default(uuid())

  name String // Ganesh Puja
  date DateTime // 2026-09-19
  day  String // Friday (store for fast UI)
  year Int // 2026

  type        HolidayType
  description String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, organizationId])
}

///////////////////////////
// LEAVE BALANCE
///////////////////////////
model LeaveBalance {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leaveType LeaveType
  allocated Int       @default(0)
  used      Int       @default(0)
  remaining Int       @default(0)
  year      Int       

  createdAt DateTime @default(now())

  @@unique([organizationId, userId, leaveType, year])
  @@index([organizationId])
  @@index([userId])
}

///////////////////////////
// LEAVE APPLICTAIONS
///////////////////////////
model LeaveApplication {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)

  comments LeaveComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
}

///////////////////////////
// ANNOUNCEMENT
///////////////////////////
model Announcement {
  id String @id @default(uuid())

  // =========================
  // Organization & Creator
  // =========================
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  createdBy   User   @relation("CreatedAnnouncements", fields: [createdById], references: [id])
  createdById String

  // =========================
  // Content
  // =========================
  title   String
  message String

  sendType AnnouncementSendType

  // =========================
  // Relations
  // =========================
  recipients AnnouncementRecipient[]

  // =========================
  // System
  // =========================
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

///////////////////////////
// ANNOUNCEMENT RECIPIENT
///////////////////////////
model AnnouncementRecipient {
  id String @id @default(uuid())

  // =========================
  // Relations
  // =========================
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // =========================
  // Snapshot Data
  // =========================
  email String // email at time of sending

  // =========================
  // Read Tracking (future)
  // =========================
  isRead Boolean   @default(false)
  readAt DateTime?

  // =========================
  // System
  // =========================
  createdAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

///////////////////////////
// FINANCIAL DETAILS
///////////////////////////
model FinancialDetails {
  id String @id @default(uuid())

  bankName  String?
  accountNo String?
  ifscCode  String?
  panNumber String?
  uanNo     String?
  esicNo    String?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////
// PAYROLL DETAILS
///////////////////////////
model PayrollSettings {
  id String @id @default(uuid())

  overtime   Boolean @default(false)
  conveyance Boolean @default(false)
  medical    Boolean @default(false)
  pf         Boolean @default(false)
  es         Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////
// COMMENTS DETAILS
///////////////////////////
model LeaveComment {
  id String @id @default(uuid())

  leave   LeaveApplication @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  leaveId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  message String

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leaveId])
  @@index([userId])
}

///////////////////////////
// USER DOCUMENTS
///////////////////////////
model UserDocument {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  uploadedBy   User   @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  uploadedById String

  documentType   String
  documentName   String
  
  storagePath    String
  mimeType       String
  fileSize       Int

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, documentType])
  @@index([organizationId])
  @@index([userId])
  @@index([uploadedById])
}

model Attendance {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  date DateTime // Store only date part (00:00:00 time)

  punchIn  DateTime?
  punchOut DateTime?

  totalMinutes Int? // Calculated on punch out

  status AttendanceStatus @default(PRESENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([organizationId])
  @@index([userId])
}

///////////////////////////
// DEPARTMENT
///////////////////////////
model Department {
  id       String  @id @default(uuid())
  name     String  
  isActive Boolean @default(true)

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  designations Designation[]

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

///////////////////////////
// DESIGNATION
///////////////////////////
model Designation {
  id           String     @id @default(uuid())
  name         String 

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  
  users User[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, departmentId, name])
  @@index([organizationId])
  @@index([departmentId])
}

///////////////////////////
// CALENDER EVENT
///////////////////////////
model CalendarEvent {
  id String @id @default(uuid())

  title       String
  description String?

  startDate DateTime
  endDate   DateTime?

  allDay Boolean @default(true)

  category CalendarEventCategory @default(OTHER)

  // Organization
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  // Audit
  createdBy   User   @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  createdById String

  updatedBy   User?   @relation("CalendarEventUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  deletedBy   User?   @relation("CalendarEventDeletedBy", fields: [deletedById], references: [id])
  deletedById String?

  isDeleted Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@index([startDate])
}
